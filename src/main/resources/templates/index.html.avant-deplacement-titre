<!DOCTYPE html>
<html lang="fr" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1">
    <title>YNS Equipements</title>
    <link rel="stylesheet" th:href="@{/css/style.css(v=10)}">
    <link rel="icon" type="image/png"
          th:href="@{/favicon.png(v=1791073844)}"
          href="/favicon.png?v=1791073844">
    <link rel="apple-touch-icon"
          th:href="@{/favicon.png(v=1791073844)}"
          href="/favicon.png?v=1791073844">
</head>
<body>

<header th:replace="~{fragments :: header}"></header>

<main>
    <section class="hero">
        <div class="container">
            <span class="surtitre">Matériel sélectionné</span>

            <h1>
                Audiovisuel et composants informatiques
            </h1>

            <p>
                Consultez les annonces, ajoutez le matériel à votre
                sélection et envoyez une demande de réservation.
            </p>

            <a th:href="@{/catalogue}"
               class="btn btn-primary">
                Voir le catalogue
            </a>
        </div>
    </section>

    <section class="container section">
        <div class="titre-section">
            <div>
                <span class="surtitre">Disponible maintenant</span>
                <h2>Dernières annonces</h2>
            </div>

            <a th:href="@{/catalogue}">
                Voir tout
            </a>
        </div>

        
<!-- CONTACT RAPIDE AVANT LES ANNONCES -->
<div class="yns-extra-contact yns-contact-before-products">
            <div>
                <span class="yns-extra-kicker">Contact rapide</span>
                <h2>Une question sur un produit ?</h2>
                <p>
                    Contactez YNS Equipements par email ou Instagram pour
                    obtenir des informations complémentaires.
                </p>
            </div>

            <div class="yns-extra-buttons">
                <a class="yns-extra-button yns-email"
                   href="mailto:yanisroum01@gmail.com">
                    Envoyer un email
                </a>

                <a class="yns-extra-button yns-instagram"
                   href="https://www.instagram.com/yns_equipements/"
                   target="_blank" rel="noopener noreferrer">
                    Contacter sur Instagram
                </a>
            </div>
        </div>
<!-- FIN CONTACT RAPIDE -->

<div class="grille">
            <article th:each="annonce : ${annonces}"
                     class="carte">

                <a th:href="@{/annonce/{id}(id=${annonce.id})}">
                    <img th:src="${annonce.photoPrincipale()}"
                         th:alt="${annonce.titre}">
                </a>

                <div class="carte-contenu">
                    <span class="categorie"
                          th:text="${annonce.categorie}">
                    </span>

                    <h3 th:text="${annonce.titre}"></h3>

                    <p th:text="${annonce.etat}"></p>

                    <div class="prix-statut">
                        <strong th:text="${annonce.prix + ' €'}"></strong>

                        <span class="statut"
                              th:classappend="${annonce.statutCss()}"
                              th:text="${annonce.statut}">
                        </span>
                    </div>

                    <a th:href="@{/annonce/{id}(id=${annonce.id})}"
                       class="btn btn-outline btn-block">
                        Voir le matériel
                    </a>
                </div>
            </article>
        </div>
    </section>





<!-- YNS-INFOS-DEBUT -->
<section class="yns-extra-section" id="confiance">
    <div class="yns-extra-container">





        <div class="yns-extra-heading">
            <span class="yns-extra-kicker">Nos engagements</span>
            <h2>Achetez en toute confiance</h2>
            <p>
                Chaque produit est sélectionné avec attention afin de proposer
                du matériel recherché, fiable et offrant un excellent rapport
                qualité-prix.
            </p>
        </div>

        <div class="yns-extra-grid">
            <article class="yns-extra-card">
                <div class="yns-extra-icon">✓</div>
                <h3>Produits vérifiés</h3>
                <p>
                    Le fonctionnement et l'état du matériel sont vérifiés avant
                    la publication de chaque annonce.
                </p>
            </article>

            <article class="yns-extra-card">
                <div class="yns-extra-icon">€</div>
                <h3>Paiement sécurisé</h3>
                <p>
                    Les paiements sont réalisés uniquement sur Vinted,
                    Leboncoin ou lors d'une remise en main propre.
                </p>
            </article>

            <article class="yns-extra-card">
                <div class="yns-extra-icon">★</div>
                <h3>Qualité-prix</h3>
                <p>
                    Nous privilégions du matériel utile et demandé, choisi pour
                    sa qualité, son usage et la cohérence de son prix.
                </p>
            </article>
        </div>

        

        

    </div>
</section>
<!-- YNS-INFOS-FIN -->

<!-- PRESENTATION-V4 -->



<!-- PRESENTATION-V4 -->
<section id="a-propos" class="yns-about-v4">
    <div class="yns-about-v4__container">

        <div class="yns-about-v4__presentation">
            <p class="yns-about-v4__label">À propos de YNS Equipements</p>

            <h2>La passion du matériel, avec un service fondé sur la confiance.</h2>

            <p class="yns-about-v4__introduction">
                YNS Equipements est un projet créé par
                <strong>Djafour Yanis</strong>, étudiant en informatique et
                passionné par l’univers de la high-tech, de l’audiovisuel
                et du cyclisme.
            </p>

            <p>
                Nous sélectionnons avec attention du matériel audiovisuel,
                informatique et quelques équipements de cyclisme. Chaque
                annonce présente clairement l’état, les caractéristiques
                et les photos du produit afin de vous permettre de choisir
                en toute transparence.
            </p>

            <p>
                Nous nous engageons à proposer des produits authentiques à
                des prix compétitifs. Les paiements sont réalisés de manière
                sécurisée par l’intermédiaire de Leboncoin ou Vinted.
                La livraison est possible en France et en Europe, ainsi que
                la remise en main propre selon la localisation.
            </p>

            
<div class="yns-selection-note">
    <strong>Notre sélection</strong>
    <p>
        Chez YNS Equipements, chaque produit est sélectionné avec la même
        exigence que s’il était destiné à mon propre usage. Je privilégie
        du matériel recherché, fiable et de haute qualité, offrant un
        excellent rapport qualité-prix. Mon objectif est de proposer des
        équipements que je pourrais moi-même choisir et recommander en
        toute confiance.
    </p>
</div>

<div class="yns-about-v4__values">
                <span>Confiance</span>
                <span>Honnêteté</span>
                <span>Confiance</span>
            </div>

            <div class="yns-about-v4__editor">
                <div class="yns-about-v4__editor-icon">Y</div>
                <div>
                    <strong>Djafour Yanis</strong>
                    <a href="mailto:yanisroum01@gmail.com">
                        yanisroum01@gmail.com
                    </a>
                </div>
            </div>
        </div>

        <aside class="yns-about-v4__social">
            <p class="yns-about-v4__label">Nos comptes officiels</p>
            <h3>Retrouvez toutes nos annonces</h3>
            <p class="yns-about-v4__social-text">
                Consultez nos profils officiels pour acheter en toute
                sécurité ou découvrir nos nouveautés.
            </p>

            <div class="yns-about-v4__links">

                <a class="yns-social-card yns-social-card--vinted"
                   href="https://www.vinted.fr/member/295112160/feedback"
                   target="_blank"
                   rel="noopener noreferrer">
                    <span class="yns-social-card__icon" aria-hidden="true">
                        <svg viewBox="0 0 48 48">
                            <path d="M12 10l8 28h8l8-28h-7l-5 20-5-20z"/>
                        </svg>
                    </span>
                    <span class="yns-social-card__content">
                        <strong>Vinted</strong>
                        <small>Voir notre dressing</small>
                    </span>
                    <span class="yns-social-card__arrow">→</span>
                </a>

                <a class="yns-social-card yns-social-card--leboncoin"
                   href="https://www.leboncoin.fr/profile/ff32c61b-0f71-467c-88d9-50efcc6a5fc8"
                   target="_blank"
                   rel="noopener noreferrer">
                    <span class="yns-social-card__icon" aria-hidden="true">
                        <svg viewBox="0 0 48 48">
                            <rect x="6" y="6" width="36" height="36" rx="10"/>
                            <circle cx="24" cy="24" r="9"/>
                        </svg>
                    </span>
                    <span class="yns-social-card__content">
                        <strong>Leboncoin</strong>
                        <small>Consulter nos annonces</small>
                    </span>
                    <span class="yns-social-card__arrow">→</span>
                </a>

                <a class="yns-social-card yns-social-card--subito"
                       href="https://www.subito.it/utente/145010613"
                       target="_blank"
                       rel="noopener noreferrer">
                        <span class="yns-social-card__icon" aria-hidden="true">
                            <span class="yns-subito-letter">S</span>
                        </span>
                        <span class="yns-social-card__content">
                            <strong>Subito</strong>
                            <small>Découvrir notre profil</small>
                        </span>
                    </a>

                    <a class="yns-social-card yns-social-card--instagram"
                   href="https://www.instagram.com/yns_equipements/"
                   target="_blank"
                   rel="noopener noreferrer">
                    <span class="yns-social-card__icon" aria-hidden="true">
                        <svg viewBox="0 0 48 48">
                            <rect x="8" y="8" width="32" height="32"
                                  rx="10" fill="none" stroke="currentColor"
                                  stroke-width="4"/>
                            <circle cx="24" cy="24" r="8"
                                    fill="none" stroke="currentColor"
                                    stroke-width="4"/>
                            <circle cx="34" cy="14" r="2.5"/>
                        </svg>
                    </span>
                    <span class="yns-social-card__content">
                        <strong>Instagram</strong>
                        <small>Suivre nos nouveautés</small>
                    </span>
                    <span class="yns-social-card__arrow">→</span>
                </a>

            </div>
        </aside>
    </div>
</section>

</main>

<footer th:replace="~{fragments :: footer}"></footer>

</body>
</html>
